{
  "format": 1,
  "factHashVersion": 1,
  "description": "Golden vectors for canonicalJson and sourceFactHash (synthetic, built from committed catalog rows). A fact hash is sha256 (lower-case hex) of the UTF-8 canonical JSON of the fact document; the sources below are hashed with the given model and firmware. Not part of the fact document, so they must not change the hash: id, origin, capturedAt, codecVersion, fileVersion, contentSha256, issues, the live walk statistics; for live sources also record kind, count, x, t1, t2, unit, taper and the scope maxParamId, bounds and idLists. The vectors are copied verbatim into the backend repository: changing them requires a FACT_HASH_VERSION bump.",
  "canonicalJson": [
    {
      "name": "empty containers",
      "input": {
        "a": {},
        "b": []
      },
      "expected": "{\"a\":{},\"b\":[]}"
    },
    {
      "name": "keys sort by UTF-16 code unit, not numerically",
      "input": {
        "9": 5,
        "10": 4,
        "b": 1,
        "a": 2,
        "B": 3,
        "é": 6,
        "aa": 7
      },
      "expected": "{\"10\":4,\"9\":5,\"B\":3,\"a\":2,\"aa\":7,\"b\":1,\"é\":6}"
    },
    {
      "name": "literals and nesting",
      "input": {
        "z": null,
        "y": true,
        "x": false,
        "w": [
          {
            "b": 1,
            "a": []
          }
        ]
      },
      "expected": "{\"w\":[{\"a\":[],\"b\":1}],\"x\":false,\"y\":true,\"z\":null}"
    },
    {
      "name": "integers are exact",
      "input": [
        0,
        1,
        -1,
        100,
        20000,
        1000000,
        1234567,
        16777216,
        1e+21
      ],
      "expected": "[0,1,-1,100,20000,1000000,1234567,16777216,1e+21]"
    },
    {
      "name": "other numbers have six significant digits",
      "input": [
        0.5,
        -12.5,
        0.1,
        0.10000000149011612,
        0.30000000000000004,
        99.99999,
        1234567.875,
        0.000123456789,
        1e-7,
        -1.234567e-7
      ],
      "expected": "[0.5,-12.5,0.1,0.1,0.3,100,1234570,0.000123457,1e-7,-1.23457e-7]"
    },
    {
      "name": "strings use the ECMAScript JSON form",
      "input": [
        "a\"b\\c",
        "x\u0001y\nz\tq",
        "é€🎸",
        "\ud800",
        "</script>"
      ],
      "expected": "[\"a\\\"b\\\\c\",\"x\\u0001y\\nz\\tq\",\"é€🎸\",\"\\ud800\",\"</script>\"]"
    },
    {
      "name": "a key needing escapes",
      "input": {
        "k\"\\": 1
      },
      "expected": "{\"k\\\"\\\\\":1}"
    }
  ],
  "sources": [
